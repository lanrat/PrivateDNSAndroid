<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12 and higher (android:dataExtractionRules).
     A pending automatic switch back to Private DNS only makes sense on this device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auto_revert_state.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auto_revert_state.xml" />
    </device-transfer>
</data-extraction-rules>
